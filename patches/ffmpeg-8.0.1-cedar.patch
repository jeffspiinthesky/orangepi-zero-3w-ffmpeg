+
+#ifndef AVCODEC_CEDAR_COMMON_H
+#define AVCODEC_CEDAR_COMMON_H
+
+#include <veInterface.h>
+#include "libavutil/log.h"
+
+/* Exported by libVE.so; takes the engine type (0 = generic AW engine). */
+extern VeOpsS *GetVeOpsS(int type);
+
+/* libcdc_base.so's log threshold, shared by every libcedarc component. The
+ * vendor code printf()s to stdout, which corrupts "ffmpeg ... -" pipes, and
+ * re-reads it from /etc/cedarc.conf during init, so callers re-apply this
+ * after each vendor init call. */
+extern int GLOBAL_LOG_LEVEL;
+
+static inline void cedar_quiet_vendor_logs(void)
+{
+    if (av_log_get_level() < AV_LOG_DEBUG)
+        GLOBAL_LOG_LEVEL = 7;   /* above LOG_LEVEL_ERROR (6): print nothing */
+}
+
+#endif /* AVCODEC_CEDAR_COMMON_H */
diff -ruN ffmpeg-8.0.1/libavcodec/cedardec.c ../b/ffmpeg-8.0.1/libavcodec/cedardec.c
--- a/libavcodec/cedardec.c	1970-01-01 00:00:00.000000000 +0000
+++ b/libavcodec/cedardec.c	2026-10-07 17:42:37.563232761 +0000
@@ -0,0 +1,587 @@
+/*
+ * Allwinner Cedar (libcedarc / libvdecoder) hardware video decoders
+ *
+ * Drives the vendor libvdecoder.so on /dev/cedar_dev, as shipped on
+ * Allwinner A733 / T527 / A527 BSP images (Orange Pi OS, Radxa, etc).
+ *
+ * Output is either NV12 software frames (the default, copied out of the
+ * decoder's surfaces so they can feed any filter or encoder), or zero-copy
+ * DRM_PRIME frames wrapping the surface's dma-buf when the caller's
+ * get_format() asks for them (e.g. mpv --hwdec=cedar).
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <pthread.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <drm_fourcc.h>
+#include <vdecoder.h>
+#include <memoryAdapter.h>
+
+#include "avcodec.h"
+#include "cedar_common.h"
+#include "codec_internal.h"
+#include "decode.h"
+#include "hwconfig.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_drm.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/refstruct.h"
+#include "libavutil/time.h"
+
+/* How long to keep decoding at EOF without a new picture before we decide
+ * the hardware is empty. */
+#define CEDAR_DRAIN_TIMEOUT_US  (200 * 1000)
+/* How long to wait for room in the stream buffer (or for the caller to give
+ * back zero-copy frames) before dropping a packet. */
+#define CEDAR_SUBMIT_TIMEOUT_US (2000 * 1000)
+
+/* The vendor decoder and everything it allocated. Refcounted, because
+ * zero-copy frames hold its surfaces and may outlive the AVCodecContext. */
+typedef struct CedarDecoder {
+    VideoDecoder     *dec;
+    struct ScMemOpsS *memops;
+    pthread_mutex_t   lock;         /* serialises every libvdecoder call */
+    AVBufferRef      *device_ref;
+    AVBufferRef      *frames_ref;
+} CedarDecoder;
+
+typedef struct CedarDecContext {
+    const AVClass *class;
+
+    CedarDecoder     *d;
+    int               cedar_codec;
+    enum AVPixelFormat out_fmt;     /* NONE until the first picture */
+
+    AVPacket          pkt;          /* packet waiting for stream-buffer room */
+    int               eof;
+    int64_t           drain_deadline;
+
+    /* options */
+    int               nb_buffers;
+    int               frame_package;
+} CedarDecContext;
+
+typedef struct CedarFrameRef {
+    AVDRMFrameDescriptor desc;      /* must be first: it is frame->data[0] */
+    CedarDecoder        *d;
+    VideoPicture        *pic;
+} CedarFrameRef;
+
+static int cedar_codec_from_id(enum AVCodecID id)
+{
+    switch (id) {
+    case AV_CODEC_ID_H264:       return VIDEO_CODEC_FORMAT_H264;
+    case AV_CODEC_ID_HEVC:       return VIDEO_CODEC_FORMAT_H265;
+    case AV_CODEC_ID_VP8:        return VIDEO_CODEC_FORMAT_VP8;
+    case AV_CODEC_ID_VP9:        return VIDEO_CODEC_FORMAT_VP9;
+    case AV_CODEC_ID_MPEG1VIDEO: return VIDEO_CODEC_FORMAT_MPEG1;
+    case AV_CODEC_ID_MPEG2VIDEO: return VIDEO_CODEC_FORMAT_MPEG2;
+    case AV_CODEC_ID_MPEG4:      return VIDEO_CODEC_FORMAT_MPEG4;
+    default:                     return VIDEO_CODEC_FORMAT_UNKNOWN;
+    }
+}
+
+static void cedar_release_decoder(AVRefStructOpaque unused, void *obj)
+{
+    CedarDecoder *d = obj;
+
+    if (d->dec)
+        DestroyVideoDecoder(d->dec);
+    if (d->memops)
+        CdcMemClose(d->memops);
+    av_buffer_unref(&d->frames_ref);
+    av_buffer_unref(&d->device_ref);
+    pthread_mutex_destroy(&d->lock);
+}
+
+static av_cold int cedar_close_decoder(AVCodecContext *avctx)
+{
+    CedarDecContext *s = avctx->priv_data;
+
+    av_packet_unref(&s->pkt);
+    av_refstruct_unref(&s->d);
+    return 0;
+}
+
+static av_cold int cedar_init_decoder(AVCodecContext *avctx)
+{
+    CedarDecContext *s = avctx->priv_data;
+    VideoStreamInfo si = { 0 };
+    VConfig vc = { 0 };
+    CedarDecoder *d;
+
+    s->cedar_codec = cedar_codec_from_id(avctx->codec_id);
+    if (s->cedar_codec == VIDEO_CODEC_FORMAT_UNKNOWN)
+        return AVERROR(ENOSYS);
+    s->out_fmt = AV_PIX_FMT_NONE;
+
+    if (access("/dev/cedar_dev", R_OK | W_OK)) {
+        av_log(avctx, AV_LOG_ERROR, "Cannot access /dev/cedar_dev: %s\n",
+               strerror(errno));
+        return AVERROR(errno);
+    }
+
+    d = s->d = av_refstruct_alloc_ext(sizeof(*d), 0, NULL, cedar_release_decoder);
+    if (!d)
+        return AVERROR(ENOMEM);
+    pthread_mutex_init(&d->lock, NULL);
+
+    cedar_quiet_vendor_logs();
+    d->memops = MemAdapterGetOpsS();
+    /* CdcMemOpen() is the real initialiser; CdcMemOpen2() wants VE ops. */
+    if (!d->memops || CdcMemOpen(d->memops) != 0) {
+        av_log(avctx, AV_LOG_ERROR, "Could not open the Cedar memory adapter\n");
+        d->memops = NULL;
+        return AVERROR_EXTERNAL;
+    }
+
+    AddVDPlugin();  /* loads the per-codec libaw*.so plugins */
+
+    d->dec = CreateVideoDecoder();
+    if (!d->dec) {
+        av_log(avctx, AV_LOG_ERROR, "CreateVideoDecoder failed\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    si.eCodecFormat = s->cedar_codec;
+    si.nWidth       = avctx->coded_width  ? avctx->coded_width  : avctx->width;
+    si.nHeight      = avctx->coded_height ? avctx->coded_height : avctx->height;
+    if (avctx->framerate.num && avctx->framerate.den)
+        si.nFrameRate = (int)(av_q2d(avctx->framerate) * 1000);
+    /* Every packet from libavformat is one complete coded frame (H.264/HEVC
+     * converted to Annex-B with in-band parameter sets by the BSF). */
+    si.bIsFramePackage = s->frame_package;
+    if (avctx->codec_id != AV_CODEC_ID_H264 &&
+        avctx->codec_id != AV_CODEC_ID_HEVC && avctx->extradata_size > 0) {
+        si.pCodecSpecificData    = (char *)avctx->extradata;
+        si.nCodecSpecificDataLen = avctx->extradata_size;
+    }
+
+    vc.memops             = d->memops;
+    vc.veOpsS             = GetVeOpsS(0);
+    vc.pVeOpsSelf         = NULL;
+    vc.eOutputPixelFormat = PIXEL_FORMAT_NV12;
+    /* Zero-copy callers hold surfaces for display, so leave them room. */
+    vc.nFrameBufferNum    = s->nb_buffers + FFMAX(avctx->extra_hw_frames, 0);
+    vc.bDispErrorFrame    = 1;
+    /* Leaving this at 0 deadlocks the decoder after about a dozen frames on
+     * many ordinary streams (every DecodeVideoStream then returns
+     * NO_FRAME_BUFFER). */
+    vc.nDecodeSmoothFrameBufferNum = 3;
+    /* 10-bit VP9 is down-converted in hardware; keep the output 8-bit NV12. */
+    vc.bConvertVp910bitTo8bit = 1;
+    vc.eCtlAfbcMode = DISABLE_AFBC_ALL_SIZE;
+
+    if (InitializeVideoDecoder(d->dec, &si, &vc) != 0) {
+        av_log(avctx, AV_LOG_ERROR, "InitializeVideoDecoder failed\n");
+        return AVERROR_EXTERNAL;
+    }
+    cedar_quiet_vendor_logs();
+
+    avctx->pix_fmt = AV_PIX_FMT_NV12;
+    av_log(avctx, AV_LOG_VERBOSE, "Cedar %s decoder ready\n",
+           avcodec_get_name(avctx->codec_id));
+    return 0;
+}
+
+static void cedar_return_picture(CedarDecoder *d, VideoPicture *pic)
+{
+    pthread_mutex_lock(&d->lock);
+    ReturnPicture(d->dec, pic);
+    pthread_mutex_unlock(&d->lock);
+}
+
+static void cedar_release_drm_frame(void *opaque, uint8_t *data)
+{
+    CedarFrameRef *ref = (CedarFrameRef *)data;
+
+    cedar_return_picture(ref->d, ref->pic);
+    av_refstruct_unref(&ref->d);
+    av_free(ref);
+}
+
+/* Pick NV12 or DRM_PRIME once we know the real picture size. */
+static int cedar_negotiate(AVCodecContext *avctx)
+{
+    CedarDecContext *s = avctx->priv_data;
+    CedarDecoder *d = s->d;
+    /* NV12 first: callers that do not ask for hardware frames get software
+     * ones, so plain "ffmpeg -c:v h264_cedar" just works. */
+    static const enum AVPixelFormat fmts[] = {
+        AV_PIX_FMT_NV12, AV_PIX_FMT_DRM_PRIME, AV_PIX_FMT_NONE
+    };
+    AVHWFramesContext *hwfc;
+    int ret;
+
+    ret = ff_get_format(avctx, fmts);
+    if (ret < 0)
+        return ret;
+    s->out_fmt = avctx->pix_fmt = ret;
+    if (s->out_fmt != AV_PIX_FMT_DRM_PRIME)
+        return 0;
+
+    if (!d->device_ref) {
+        d->device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_DRM);
+        if (!d->device_ref)
+            return AVERROR(ENOMEM);
+        ret = av_hwdevice_ctx_init(d->device_ref);
+        if (ret < 0)
+            return ret;
+    }
+    av_buffer_unref(&d->frames_ref);
+    d->frames_ref = av_hwframe_ctx_alloc(d->device_ref);
+    if (!d->frames_ref)
+        return AVERROR(ENOMEM);
+    hwfc            = (AVHWFramesContext *)d->frames_ref->data;
+    hwfc->format    = AV_PIX_FMT_DRM_PRIME;
+    hwfc->sw_format = AV_PIX_FMT_NV12;
+    hwfc->width     = avctx->width;
+    hwfc->height    = avctx->height;
+    ret = av_hwframe_ctx_init(d->frames_ref);
+    if (ret < 0)
+        return ret;
+
+    av_log(avctx, AV_LOG_VERBOSE, "Cedar decoder: zero-copy DRM_PRIME output\n");
+    return 0;
+}
+
+static int cedar_wrap_drm(AVCodecContext *avctx, VideoPicture *pic,
+                          AVFrame *frame)
+{
+    CedarDecContext *s = avctx->priv_data;
+    int stride = pic->nLineStride ? pic->nLineStride : pic->nWidth;
+    CedarFrameRef *ref;
+    AVDRMLayerDescriptor *layer;
+
+    ref = av_mallocz(sizeof(*ref));
+    if (!ref)
+        return AVERROR(ENOMEM);
+
+    ref->desc.nb_objects      = 1;
+    ref->desc.objects[0].fd   = pic->nBufFd;
+    ref->desc.objects[0].size = pic->nBufSize > 0 ? pic->nBufSize :
+                                (size_t)stride * pic->nHeight * 3 / 2;
+    ref->desc.objects[0].format_modifier = DRM_FORMAT_MOD_LINEAR;
+
+    ref->desc.nb_layers = 1;
+    layer = &ref->desc.layers[0];
+    layer->format    = DRM_FORMAT_NV12;
+    layer->nb_planes = 2;
+    layer->planes[0].object_index = 0;
+    layer->planes[0].offset       = 0;
+    layer->planes[0].pitch        = stride;
+    layer->planes[1].object_index = 0;
+    layer->planes[1].offset       = pic->pData1 - pic->pData0;
+    layer->planes[1].pitch        = stride;
+
+    frame->buf[0] = av_buffer_create((uint8_t *)ref, sizeof(*ref),
+                                     cedar_release_drm_frame, NULL,
+                                     AV_BUFFER_FLAG_READONLY);
+    if (!frame->buf[0]) {
+        av_free(ref);
+        return AVERROR(ENOMEM);
+    }
+    /* From here on the buffer's free callback returns the picture. */
+    ref->d   = av_refstruct_ref(s->d);
+    ref->pic = pic;
+
+    frame->data[0]       = (uint8_t *)&ref->desc;
+    frame->format        = AV_PIX_FMT_DRM_PRIME;
+    frame->width         = avctx->width;
+    frame->height        = avctx->height;
+    frame->hw_frames_ctx = av_buffer_ref(s->d->frames_ref);
+    if (!frame->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+    return 0;
+}
+
+/* Hand one decoded Cedar picture to the caller, either wrapped (zero-copy)
+ * or copied into an NV12 AVFrame. */
+static int cedar_output_picture(AVCodecContext *avctx, VideoPicture *pic,
+                                AVFrame *frame)
+{
+    CedarDecContext *s = avctx->priv_data;
+    CedarDecoder *d = s->d;
+    int left   = pic->nLeftOffset, top = pic->nTopOffset;
+    int width  = (pic->nRightOffset  > left ? pic->nRightOffset  : pic->nWidth)  - left;
+    int height = (pic->nBottomOffset > top  ? pic->nBottomOffset : pic->nHeight) - top;
+    int stride = pic->nLineStride ? pic->nLineStride : pic->nWidth;
+    int ret;
+
+    if (pic->ePixelFormat != PIXEL_FORMAT_NV12 || pic->bEnableAfbcFlag ||
+        pic->b10BitPicFlag) {
+        av_log(avctx, AV_LOG_ERROR,
+               "Unsupported Cedar output (format %d, afbc %d, 10-bit %d)\n",
+               pic->ePixelFormat, pic->bEnableAfbcFlag, pic->b10BitPicFlag);
+        ret = AVERROR_PATCHWELCOME;
+        goto fail;
+    }
+
+    if (width != avctx->width || height != avctx->height ||
+        s->out_fmt == AV_PIX_FMT_NONE) {
+        ret = ff_set_dimensions(avctx, width, height);
+        if (ret < 0)
+            goto fail;
+        ret = cedar_negotiate(avctx);
+        if (ret < 0)
+            goto fail;
+    }
+
+    if (s->out_fmt == AV_PIX_FMT_DRM_PRIME && !left && !top) {
+        ret = cedar_wrap_drm(avctx, pic, frame);
+        if (ret < 0) {
+            if (!frame->buf[0])
+                goto fail;
+            return ret;   /* buf[0] already owns the picture */
+        }
+    } else {
+        const uint8_t *src[4] = { NULL };
+        int src_linesize[4] = { stride, stride, 0, 0 };
+
+        frame->format = AV_PIX_FMT_NV12;
+        frame->width  = width;
+        frame->height = height;
+        ret = ff_get_buffer(avctx, frame, 0);
+        if (ret < 0)
+            goto fail;
+
+        /* The VE wrote these surfaces behind the CPU's back. */
+        CdcMemFlushCache(d->memops, pic->pData0, stride * pic->nHeight);
+        CdcMemFlushCache(d->memops, pic->pData1, stride * pic->nHeight / 2);
+
+        src[0] = (const uint8_t *)pic->pData0 + top * stride + left;
+        src[1] = (const uint8_t *)pic->pData1 + (top / 2) * stride + (left & ~1);
+        av_image_copy2(frame->data, frame->linesize, (uint8_t **)src,
+                       src_linesize, AV_PIX_FMT_NV12, width, height);
+        cedar_return_picture(d, pic);
+    }
+
+    frame->pts     = pic->nPts == -1 ? AV_NOPTS_VALUE : pic->nPts;
+    frame->pkt_dts = AV_NOPTS_VALUE;
+    if (!pic->bIsProgressive) {
+        frame->flags |= AV_FRAME_FLAG_INTERLACED;
+        if (pic->bTopFieldFirst)
+            frame->flags |= AV_FRAME_FLAG_TOP_FIELD_FIRST;
+    }
+    return 0;
+
+fail:
+    cedar_return_picture(d, pic);
+    return ret;
+}
+
+/* Try to move s->pkt into the Cedar stream buffer. Returns 1 when it went
+ * in, 0 when there is no room yet. Called with the decoder lock held. */
+static int cedar_submit(AVCodecContext *avctx)
+{
+    CedarDecContext *s = avctx->priv_data;
+    VideoDecoder *dec = s->d->dec;
+    char *buf = NULL, *ring = NULL;
+    int bufsz = 0, ringsz = 0;
+    VideoStreamDataInfo di = { 0 };
+
+    if (RequestVideoStreamBuffer(dec, s->pkt.size, &buf, &bufsz,
+                                 &ring, &ringsz, 0) != 0 || !buf ||
+        bufsz + ringsz < s->pkt.size)
+        return 0;
+
+    /* The stream buffer is a ring; a request may straddle its end. */
+    if (bufsz >= s->pkt.size) {
+        memcpy(buf, s->pkt.data, s->pkt.size);
+    } else {
+        memcpy(buf, s->pkt.data, bufsz);
+        memcpy(ring, s->pkt.data + bufsz, s->pkt.size - bufsz);
+    }
+
+    di.pData        = buf;
+    di.nLength      = s->pkt.size;
+    di.bIsFirstPart = 1;
+    di.bIsLastPart  = 1;
+    di.nPts         = s->pkt.pts == AV_NOPTS_VALUE ? -1 : s->pkt.pts;
+    di.nPcr         = -1;
+    di.bValid       = 1;
+    if (SubmitVideoStreamData(dec, &di, 0) != 0)
+        av_log(avctx, AV_LOG_WARNING, "SubmitVideoStreamData failed\n");
+
+    av_packet_unref(&s->pkt);
+    return 1;
+}
+
+static VideoPicture *cedar_request(CedarDecoder *d)
+{
+    VideoPicture *pic;
+
+    pthread_mutex_lock(&d->lock);
+    pic = RequestPicture(d->dec, 0);
+    pthread_mutex_unlock(&d->lock);
+    return pic;
+}
+
+static int cedar_decode(CedarDecoder *d, int eos)
+{
+    int ret;
+
+    pthread_mutex_lock(&d->lock);
+    ret = DecodeVideoStream(d->dec, eos, 0, 0, 0);
+    pthread_mutex_unlock(&d->lock);
+    return ret;
+}
+
+static int cedar_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    CedarDecContext *s = avctx->priv_data;
+    CedarDecoder *d = s->d;
+    VideoPicture *pic;
+    int64_t submit_deadline = 0;
+    int ret, submitted;
+
+    for (;;) {
+        pic = cedar_request(d);
+        if (pic)
+            return cedar_output_picture(avctx, pic, frame);
+
+        if (s->eof) {
+            /* Drain: keep the engine turning until it stops producing. */
+            ret = cedar_decode(d, 1);
+            if (ret == VDECODE_RESULT_FRAME_DECODED ||
+                ret == VDECODE_RESULT_KEYFRAME_DECODED) {
+                s->drain_deadline = av_gettime_relative() + CEDAR_DRAIN_TIMEOUT_US;
+                continue;
+            }
+            if (!s->drain_deadline)
+                s->drain_deadline = av_gettime_relative() + CEDAR_DRAIN_TIMEOUT_US;
+            if (av_gettime_relative() > s->drain_deadline)
+                return AVERROR_EOF;
+            av_usleep(1000);
+            continue;
+        }
+
+        if (!s->pkt.size) {
+            ret = ff_decode_get_packet(avctx, &s->pkt);
+            if (ret == AVERROR_EOF) {
+                s->eof = 1;
+                s->drain_deadline = 0;
+                continue;
+            } else if (ret == AVERROR(EAGAIN)) {
+                /* Nothing more to feed; let the hardware work on what it has. */
+                cedar_decode(d, 0);
+                pic = cedar_request(d);
+                if (pic)
+                    return cedar_output_picture(avctx, pic, frame);
+                return AVERROR(EAGAIN);
+            } else if (ret < 0) {
+                return ret;
+            }
+        }
+
+        pthread_mutex_lock(&d->lock);
+        submitted = cedar_submit(avctx);
+        pthread_mutex_unlock(&d->lock);
+        if (submitted) {
+            submit_deadline = 0;
+        } else {
+            /* Stream buffer full: decoding is what drains it. */
+            if (!submit_deadline)
+                submit_deadline = av_gettime_relative() + CEDAR_SUBMIT_TIMEOUT_US;
+            else if (av_gettime_relative() > submit_deadline) {
+                av_log(avctx, AV_LOG_ERROR, "Cedar stream buffer stuck; "
+                       "dropping a %d byte packet\n", s->pkt.size);
+                av_packet_unref(&s->pkt);
+                submit_deadline = 0;
+            }
+        }
+
+        ret = cedar_decode(d, 0);
+        av_log(avctx, AV_LOG_TRACE, "DecodeVideoStream: %d\n", ret);
+        if (ret == VDECODE_RESULT_UNSUPPORTED) {
+            av_log(avctx, AV_LOG_ERROR, "Stream not supported by the Cedar engine\n");
+            return AVERROR_PATCHWELCOME;
+        }
+        /* Out of surfaces: zero-copy frames come back from another thread. */
+        if (s->pkt.size && ret == VDECODE_RESULT_NO_FRAME_BUFFER)
+            av_usleep(1000);
+    }
+}
+
+static void cedar_flush(AVCodecContext *avctx)
+{
+    CedarDecContext *s = avctx->priv_data;
+
+    av_packet_unref(&s->pkt);
+    s->eof = 0;
+    s->drain_deadline = 0;
+    if (s->d && s->d->dec) {
+        pthread_mutex_lock(&s->d->lock);
+        ResetVideoDecoder(s->d->dec);
+        pthread_mutex_unlock(&s->d->lock);
+    }
+}
+
+static const AVCodecHWConfigInternal *const cedar_hw_configs[] = {
+    HW_CONFIG_INTERNAL(DRM_PRIME),
+    NULL
+};
+
+#define OFFSET(x) offsetof(CedarDecContext, x)
+#define VD AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_DECODING_PARAM
+static const AVOption options[] = {
+    { "cedar_buffers", "Number of Cedar frame buffers", OFFSET(nb_buffers),
+      AV_OPT_TYPE_INT, { .i64 = 8 }, 4, 32, VD },
+    { "cedar_frame_package", "Tell the engine each packet is a whole frame",
+      OFFSET(frame_package), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, VD },
+    { NULL }
+};
+
+#define CEDAR_DEC(NAME, LONGNAME, ID, BSFS) \
+    static const AVClass cedar_##NAME##_dec_class = { \
+        .class_name = #NAME "_cedar", \
+        .item_name  = av_default_item_name, \
+        .option     = options, \
+        .version    = LIBAVUTIL_VERSION_INT, \
+    }; \
+    const FFCodec ff_##NAME##_cedar_decoder = { \
+        .p.name         = #NAME "_cedar", \
+        CODEC_LONG_NAME(LONGNAME " (Allwinner Cedar)"), \
+        .p.type         = AVMEDIA_TYPE_VIDEO, \
+        .p.id           = ID, \
+        .priv_data_size = sizeof(CedarDecContext), \
+        .init           = cedar_init_decoder, \
+        .close          = cedar_close_decoder, \
+        FF_CODEC_RECEIVE_FRAME_CB(cedar_receive_frame), \
+        .flush          = cedar_flush, \
+        .p.priv_class   = &cedar_##NAME##_dec_class, \
+        .p.capabilities = AV_CODEC_CAP_DELAY | AV_CODEC_CAP_AVOID_PROBING | \
+                          AV_CODEC_CAP_HARDWARE, \
+        .hw_configs     = cedar_hw_configs, \
+        .bsfs           = BSFS, \
+        .p.wrapper_name = "cedar", \
+        .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | \
+                          FF_CODEC_CAP_INIT_CLEANUP, \
+    };
+
+CEDAR_DEC(h264,  "H.264 / AVC",  AV_CODEC_ID_H264,       "h264_mp4toannexb")
+CEDAR_DEC(hevc,  "H.265 / HEVC", AV_CODEC_ID_HEVC,       "hevc_mp4toannexb")
+CEDAR_DEC(vp8,   "VP8",          AV_CODEC_ID_VP8,        NULL)
+CEDAR_DEC(vp9,   "VP9",          AV_CODEC_ID_VP9,        NULL)
+CEDAR_DEC(mpeg2, "MPEG-2 video", AV_CODEC_ID_MPEG2VIDEO, NULL)
+CEDAR_DEC(mpeg4, "MPEG-4 part 2", AV_CODEC_ID_MPEG4,     NULL)
diff -ruN ffmpeg-8.0.1/libavcodec/cedarenc.c ../b/ffmpeg-8.0.1/libavcodec/cedarenc.c
