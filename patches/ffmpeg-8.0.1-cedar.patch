+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+#include <unistd.h>
+
+#include <vencoder.h>
+#include <memoryAdapter.h>
+
+#include "avcodec.h"
+#include "cbs.h"
+#include "cbs_h264.h"
+#include "cbs_h265.h"
+#include "cedar_common.h"
+#include "codec_internal.h"
+#include "encode.h"
+#include "libavutil/avassert.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+
+
+/* libcedarc's AW_VBR ignores both the target bitrate and its quality knobs
+ * (always ~1 Mb/s at 1080p) on A733, so only CBR and constant QP are offered. */
+enum { RC_CBR = AW_CBR, RC_CQP = AW_FIXQP };
+
+typedef struct CedarEncContext {
+    const AVClass *class;
+
+    VideoEncoder     *enc;
+    struct ScMemOpsS *memops;
+    int               aligned_w, aligned_h;
+    uint8_t          *header;
+    int               header_size;
+
+    /* options */
+    int rc_mode;
+    int qp;
+    int level;
+} CedarEncContext;
+
+static av_cold int cedar_close_encoder(AVCodecContext *avctx)
+{
+    CedarEncContext *s = avctx->priv_data;
+
+    if (s->enc) {
+        ReleaseAllocInputBuffer(s->enc);
+        VideoEncUnInit(s->enc);
+        VideoEncDestroy(s->enc);
+        s->enc = NULL;
+    }
+    if (s->memops) {
+        CdcMemClose(s->memops);
+        s->memops = NULL;
+    }
+    av_freep(&s->header);
+    return 0;
+}
+
+static void fill_qp_range(AVCodecContext *avctx, VencQPRange *r)
+{
+    r->nMinqp  = avctx->qmin >= 0 ? avctx->qmin : 10;
+    r->nMaxqp  = avctx->qmax >= 0 ? avctx->qmax : 50;
+    r->nMinPqp = r->nMinqp;
+    r->nMaxPqp = r->nMaxqp;
+    r->nQpInit = 30;
+}
+
+static void fill_rc(CedarEncContext *s, VencRcParam *rc)
+{
+    rc->eRcMode = s->rc_mode;
+    if (s->rc_mode == AW_FIXQP) {
+        rc->sFixQp.bEnable = 1;
+        rc->sFixQp.nIQp    = s->qp;
+        rc->sFixQp.nPQp    = s->qp;
+    }
+}
+
+/* Rewrite the SPS so decoders crop the 16-aligned coded picture back to the
+ * real frame size. Slice data does not depend on the cropping window. */
+static int cedar_set_header_crop(AVCodecContext *avctx)
+{
+    CedarEncContext *s = avctx->priv_data;
+    CodedBitstreamContext *cbc = NULL;
+    CodedBitstreamFragment frag = { 0 };
+    int crop_r = s->aligned_w - avctx->width;
+    int crop_b = s->aligned_h - avctx->height;
+    int ret, found = 0;
+
+    if (!crop_r && !crop_b)
+        return 0;
+
+    ret = ff_cbs_init(&cbc, avctx->codec_id, avctx);
+    if (ret < 0)
+        return ret;
+    ret = ff_cbs_read(cbc, &frag, NULL, s->header, s->header_size);
+    if (ret < 0)
+        goto end;
+
+    for (int i = 0; i < frag.nb_units; i++) {
+        CodedBitstreamUnit *unit = &frag.units[i];
+        if (avctx->codec_id == AV_CODEC_ID_H264 && unit->type == H264_NAL_SPS) {
+            H264RawSPS *sps = unit->content;
+            /* 4:2:0 progressive: crop units are 2x2 luma samples. */
+            sps->frame_cropping_flag      = 1;
+            sps->frame_crop_left_offset   = 0;
+            sps->frame_crop_top_offset    = 0;
+            sps->frame_crop_right_offset  = crop_r / 2;
+            sps->frame_crop_bottom_offset = crop_b / 2;
+            found = 1;
+        } else if (avctx->codec_id == AV_CODEC_ID_HEVC && unit->type == HEVC_NAL_SPS) {
+            H265RawSPS *sps = unit->content;
+            sps->conformance_window_flag = 1;
+            sps->conf_win_left_offset    = 0;
+            sps->conf_win_top_offset     = 0;
+            sps->conf_win_right_offset   = crop_r / 2;
+            sps->conf_win_bottom_offset  = crop_b / 2;
+            found = 1;
+        }
+    }
+    if (!found) {
+        av_log(avctx, AV_LOG_ERROR, "No SPS found in the encoder headers\n");
+        ret = AVERROR_EXTERNAL;
+        goto end;
+    }
+
+    ret = ff_cbs_write_fragment_data(cbc, &frag);
+    if (ret < 0)
+        goto end;
+    av_freep(&s->header);
+    s->header = av_memdup(frag.data, frag.data_size);
+    s->header_size = s->header ? frag.data_size : 0;
+    ret = s->header ? 0 : AVERROR(ENOMEM);
+end:
+    ff_cbs_fragment_free(&frag);
+    ff_cbs_close(&cbc);
+    return ret;
+}
+
+static av_cold int cedar_init_encoder(AVCodecContext *avctx)
+{
+    CedarEncContext *s = avctx->priv_data;
+    VencBaseConfig cfg = { 0 };
+    VencAllocateBufferParam bp = { 0 };
+    VencHeaderData hdr = { 0 };
+    int is_hevc = avctx->codec_id == AV_CODEC_ID_HEVC;
+    int fps, bitrate, gop, ret;
+
+    if (access("/dev/cedar_dev_ve2", R_OK | W_OK)) {
+        av_log(avctx, AV_LOG_ERROR, "Cannot access /dev/cedar_dev_ve2: %s\n",
+               strerror(errno));
+        return AVERROR(errno);
+    }
+
+    /* The VE never completes a frame whose height is not 16-aligned, so
+     * encode a padded picture and signal the crop in the SPS ourselves: a
+     * smaller nDstWidth/nDstHeight makes the VE *scale*, not crop. */
+    s->aligned_w = FFALIGN(avctx->width,  16);
+    s->aligned_h = FFALIGN(avctx->height, 16);
+
+    if (avctx->framerate.num > 0 && avctx->framerate.den > 0)
+        fps = (int)lrint(av_q2d(avctx->framerate));
+    else
+        fps = (int)lrint(1.0 / av_q2d(avctx->time_base));
+    fps     = av_clip(fps, 1, 240);
+    bitrate = avctx->bit_rate > 0 ? avctx->bit_rate : 8000000;
+    gop     = avctx->gop_size > 0 ? avctx->gop_size : 2 * fps;
+
+    cedar_quiet_vendor_logs();
+    s->memops = MemAdapterGetOpsS();
+    if (!s->memops || CdcMemOpen(s->memops) != 0) {
+        av_log(avctx, AV_LOG_ERROR, "Could not open the Cedar memory adapter\n");
+        s->memops = NULL;
+        return AVERROR_EXTERNAL;
+    }
+
+    s->enc = VideoEncCreate(is_hevc ? VENC_CODEC_H265 : VENC_CODEC_H264);
+    if (!s->enc) {
+        av_log(avctx, AV_LOG_ERROR, "VideoEncCreate failed\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    /* Codec parameters must be set BEFORE VideoEncInit; afterwards they are
+     * accepted and silently ignored. */
+    if (is_hevc) {
+        VencH265Param p = { 0 };
+        p.sProfileLevel.nProfile = VENC_H265ProfileMain;
+        p.sProfileLevel.nLevel   = s->level > 0 ? s->level : VENC_H265Level51;
+        fill_qp_range(avctx, &p.sQPRange);
+        p.nFramerate    = fps;
+        p.nSrcFramerate = fps;
+        p.nBitrate      = bitrate;
+        p.nIntraPeriod  = gop;
+        p.nGopSize      = gop;
+        p.idr_period    = gop;
+        p.nQPInit       = s->rc_mode == AW_FIXQP ? s->qp : 30;
+        fill_rc(s, &p.sRcParam);
+        ret = VideoEncSetParameter(s->enc, VENC_IndexParamH265Param, &p);
+    } else {
+        VencH264Param p = { 0 };
+        /* High only: for Main/Baseline libcedarc writes headers without
+         * transform_8x8_mode (and CABAC), but the VE still codes High
+         * profile slices, so the result does not decode. */
+        p.sProfileLevel.nProfile = VENC_H264ProfileHigh;
+        p.sProfileLevel.nLevel   = s->level > 0 ? s->level : VENC_H264Level51;
+        p.bEntropyCodingCABAC    = 1;
+        fill_qp_range(avctx, &p.sQPRange);
+        p.nFramerate      = fps;
+        p.nSrcFramerate   = fps;
+        p.nBitrate        = bitrate;
+        p.nMaxKeyInterval = gop;
+        p.nCodingMode     = VENC_FRAME_CODING;
+        fill_rc(s, &p.sRcParam);
+        ret = VideoEncSetParameter(s->enc, VENC_IndexParamH264Param, &p);
+    }
+    if (ret)
+        av_log(avctx, AV_LOG_WARNING, "Encoder rejected codec parameters\n");
+
+    cfg.nInputWidth  = s->aligned_w;
+    cfg.nInputHeight = s->aligned_h;
+    cfg.nStride      = s->aligned_w;
+    cfg.nDstWidth    = s->aligned_w;
+    cfg.nDstHeight   = s->aligned_h;
+    cfg.eInputFormat = VENC_PIXEL_YUV420SP;
+    cfg.memops       = s->memops;
+    cfg.veOpsS       = GetVeOpsS(0);
+    cfg.pVeOpsSelf   = NULL;
+    if (VideoEncInit(s->enc, &cfg) != 0) {
+        av_log(avctx, AV_LOG_ERROR, "VideoEncInit failed for %dx%d\n",
+               avctx->width, avctx->height);
+        return AVERROR_EXTERNAL;
+    }
+
+    cedar_quiet_vendor_logs();
+
+    bp.nBufferNum = 2;
+    bp.nSizeY     = s->aligned_w * s->aligned_h;
+    bp.nSizeC     = s->aligned_w * s->aligned_h / 2;
+    if (AllocInputBuffer(s->enc, &bp) != 0) {
+        av_log(avctx, AV_LOG_ERROR, "AllocInputBuffer failed\n");
+        return AVERROR(ENOMEM);
+    }
+
+    /* Annex-B parameter sets (VPS/SPS/PPS). */
+    if (VideoEncGetParameter(s->enc, is_hevc ? VENC_IndexParamH265Header :
+                                               VENC_IndexParamH264SPSPPS,
+                             &hdr) != 0 || !hdr.pBuffer || !hdr.nLength) {
+        av_log(avctx, AV_LOG_ERROR, "Could not get the stream headers\n");
+        return AVERROR_EXTERNAL;
+    }
+    s->header = av_memdup(hdr.pBuffer, hdr.nLength);
+    if (!s->header)
+        return AVERROR(ENOMEM);
+    s->header_size = hdr.nLength;
+
+    ret = cedar_set_header_crop(avctx);
+    if (ret < 0)
+        return ret;
+
+    if (avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER) {
+        avctx->extradata = av_mallocz(s->header_size + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!avctx->extradata)
+            return AVERROR(ENOMEM);
+        memcpy(avctx->extradata, s->header, s->header_size);
+        avctx->extradata_size = s->header_size;
+    }
+
+    av_log(avctx, AV_LOG_VERBOSE, "Cedar %s encoder: %dx%d @ %d fps, %s %d kb/s, GOP %d\n",
+           is_hevc ? "HEVC" : "H.264", avctx->width, avctx->height, fps,
+           s->rc_mode == AW_CBR ? "CBR" : "CQP",
+           bitrate / 1000, gop);
+    return 0;
+}
+
+/* Copy an NV12/YUV420P frame into the encoder's NV12 input buffer, repeating
+ * the last row/column into the alignment padding. */
+static void copy_frame(CedarEncContext *s, const AVFrame *f, VencInputBuffer *in)
+{
+    int w = f->width, h = f->height, aw = s->aligned_w, ah = s->aligned_h;
+    uint8_t *y = in->pAddrVirY, *c = in->pAddrVirC;
+
+    for (int i = 0; i < h; i++) {
+        memcpy(y + i * aw, f->data[0] + i * f->linesize[0], w);
+        if (aw > w)
+            memset(y + i * aw + w, y[i * aw + w - 1], aw - w);
+    }
+    for (int i = h; i < ah; i++)
+        memcpy(y + i * aw, y + (h - 1) * aw, aw);
+
+    for (int i = 0; i < (h + 1) / 2; i++) {
+        uint8_t *dst = c + i * aw;
+        if (f->format == AV_PIX_FMT_NV12) {
+            memcpy(dst, f->data[1] + i * f->linesize[1], w & ~1);
+        } else {
+            const uint8_t *u = f->data[1] + i * f->linesize[1];
+            const uint8_t *v = f->data[2] + i * f->linesize[2];
+            for (int j = 0; j < w / 2; j++) {
+                dst[2 * j]     = u[j];
+                dst[2 * j + 1] = v[j];
+            }
+        }
+        for (int j = w & ~1; j < aw; j += 2) {
+            dst[j]     = dst[(w & ~1) - 2];
+            dst[j + 1] = dst[(w & ~1) - 1];
+        }
+    }
+    for (int i = (h + 1) / 2; i < ah / 2; i++)
+        memcpy(c + i * aw, c + ((h + 1) / 2 - 1) * aw, aw);
+}
+
+static int cedar_encode_frame(AVCodecContext *avctx, AVPacket *pkt,
+                              const AVFrame *frame, int *got_packet)
+{
+    CedarEncContext *s = avctx->priv_data;
+    VencInputBuffer in = { 0 };
+    VencOutputBuffer ob = { 0 };
+    int key, prepend, ret;
+    int64_t size;
+    uint8_t *p;
+
+    *got_packet = 0;
+    if (!frame)
+        return 0;   /* synchronous encoder: nothing buffered at EOF */
+
+    if (GetOneAllocInputBuffer(s->enc, &in) != 0) {
+        av_log(avctx, AV_LOG_ERROR, "No free encoder input buffer\n");
+        return AVERROR_EXTERNAL;
+    }
+    copy_frame(s, frame, &in);
+    FlushCacheAllocInputBuffer(s->enc, &in);
+    in.nPts = frame->pts;
+
+    if (frame->pict_type == AV_PICTURE_TYPE_I) {
+        int one = 1;
+        VideoEncSetParameter(s->enc, VENC_IndexParamForceKeyFrame, &one);
+    }
+
+    if (AddOneInputBuffer(s->enc, &in) != 0) {
+        ReturnOneAllocInputBuffer(s->enc, &in);
+        return AVERROR_EXTERNAL;
+    }
+    ret = VideoEncodeOneFrame(s->enc);
+    AlreadyUsedInputBuffer(s->enc, &in);
+    ReturnOneAllocInputBuffer(s->enc, &in);
+    if (ret != 0) {
+        av_log(avctx, AV_LOG_ERROR, "VideoEncodeOneFrame failed (%d)\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+
+    if (ValidBitstreamFrameNum(s->enc) <= 0 ||
+        GetOneBitstreamFrame(s->enc, &ob) != 0)
+        return 0;
+
+    key = !!(ob.nFlag & VENC_BUFFERFLAG_KEYFRAME);
+    /* The bitstream carries no in-band parameter sets; add them to every
+     * keyframe unless the container stores them globally. */
+    prepend = key && !(avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER);
+    size = (int64_t)ob.nSize0 + ob.nSize1 + (prepend ? s->header_size : 0);
+
+    ret = ff_get_encode_buffer(avctx, pkt, size, 0);
+    if (ret < 0) {
+        FreeOneBitStreamFrame(s->enc, &ob);
+        return ret;
+    }
+    p = pkt->data;
+    if (prepend) {
+        memcpy(p, s->header, s->header_size);
+        p += s->header_size;
+    }
+    memcpy(p, ob.pData0, ob.nSize0);
+    p += ob.nSize0;
+    if (ob.nSize1)
+        memcpy(p, ob.pData1, ob.nSize1);
+
+    pkt->pts = pkt->dts = ob.nPts;
+    if (key)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+    FreeOneBitStreamFrame(s->enc, &ob);
+
+    *got_packet = 1;
+    return 0;
+}
+
+static const enum AVPixelFormat cedar_enc_pix_fmts[] = {
